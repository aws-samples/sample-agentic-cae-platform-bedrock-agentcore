# Production build config — populated from CaePlatformStack CDK outputs.
# Replace these values with your own CDK stack outputs after deployment.
VITE_WEBSOCKET_ENDPOINT=wss://<YOUR_WEBSOCKET_API_ID>.execute-api.<REGION>.amazonaws.com/dev
VITE_API_ENDPOINT=https://<YOUR_HTTP_API_ID>.execute-api.<REGION>.amazonaws.com
VITE_COGNITO_USER_POOL_ID=<REGION>_<YOUR_USER_POOL_ID>
VITE_COGNITO_APP_CLIENT_ID=<YOUR_APP_CLIENT_ID>
VITE_AWS_REGION=us-east-1
