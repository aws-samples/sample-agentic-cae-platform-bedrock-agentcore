# Frontend environment variables (Vite). Copy to `.env.local` and fill in.
# All client-exposed vars must be prefixed with VITE_.

# WebSocket API Gateway endpoint (CDK stack output). Example:
#   wss://abc123.execute-api.us-east-1.amazonaws.com/prod
# Leave unset to build/run the app without a live WebSocket backend.
VITE_WEBSOCKET_ENDPOINT=

# HTTP API base URL for file uploads (CDK stack output). Example:
#   https://abc123.execute-api.us-east-1.amazonaws.com
# Uploads use HTTP (not the WebSocket gateway). Leave unset to build/run the
# app without a live upload backend.
VITE_API_ENDPOINT=

# Cognito auth (CDK stack outputs, task 2.1). Required to enable sign-in.
# Leave unset to build/run the app without a live Cognito backend (auth actions
# surface a clear "not configured" message instead of failing at load).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
# AWS region of the Cognito User Pool (e.g. us-east-1). Optional; Amplify
# derives the region from the User Pool ID when unset.
VITE_AWS_REGION=
