        "IntegrationUri": {
          "Fn::Join": [
            "",
            [
              "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/",
              {
                "Fn::GetAtt": [
                  "WebSocketDisconnectHandlerD09D008B",
                  "Arn",
                ],
              },
              "/invocations",
            ],
          ],
        },
      },
      "Type": "AWS::ApiGatewayV2::Integration",
    },
    "WsDisconnectRoute": {
      "Properties": {
        "ApiId": {
          "Ref": "WebSocketApi",
        },
